    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@escape/shared": "*",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}