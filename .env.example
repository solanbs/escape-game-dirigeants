###### GLOBAL

# Copier en .env si besoin (les valeurs par défaut suffisent en local)
PORT=3000
NODE_ENV=development
# debug | info | warn | error (défaut : debug en dev, info en prod)
LOG_LEVEL=debug
# pretty (défaut, lisible) | json (brut, pour analyser)
LOG_FORMAT=pretty

###### IOT

IOT_GATEWAY_LOG_LEVEL=debug

IOT_GATEWAY_TOKEN=secret
IOT_DEVICE_TOKEN=secret-appareils
# Bus HTTP partagé par tous les devices. À remplacer par un vrai secret en prod.
IOT_DEVICES_HTTP_HOST=0.0.0.0
IOT_DEVICES_HTTP_PORT=8080
# iot-gateway : drivers des entrées
# fake = entrées de test (stdin), http = ESP32 sur le bus HTTP local, mpv = lecteur audio.
IOT_AUDIO_DRIVER=mpv
IOT_DOOR_DRIVER=http
IOT_KEYPAD_DRIVER=http
# Pistes alarm.mp3, success.mp3, failure.mp3, ambiance.mp3.
# En Docker : /app/audio (bind mount ./audio). En dev, mettre le chemin absolu.
IOT_AUDIO_DIR=/app/audio
# Carte ALSA, ex. alsa/hw:1,0 (vide = carte par défaut)
IOT_AUDIO_DEVICE=
IOT_AUDIO_COMMAND=mpv
IOT_AUDIO_SMOKE_TEST=0
IOT_AUDIO_SMOKE_TRACK=alarm.mp3

# Dossier de scénario chargé par le serveur (relatif à la racine du dépôt)
SCENARIO_DIR=scenarios/demo

# Mot de passe du MJ (module gm, étape 6 du plan)
# GM_PASSWORD=

# Port publié par docker compose pour le serveur (défaut 3000)
# GAME_PORT=3000
