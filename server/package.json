  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.2"
  }
